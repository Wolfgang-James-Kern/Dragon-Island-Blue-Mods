{
  "name": "Less Rare Monsters",
  "description": "Increases select rare monster spawn weights to produce an approximately 20% chance that a random encounter contains at least one",
  "author": "Wolfgang Kern",
  "version": "1.0.0",
  "operations": [
    {
      "op": "plist_set",
      "file": "World_1-1.plist",
      "path": [
        "pointsOfInterest",
        {
          "match": {
            "arguments.instanceName": "1-1_Turtorial_Hut_2"
          }
        },
        "arguments",
        "encounters",
        "table",
        "1",
        "monsterPopulator",
        "arguments",
        "types",
        {
          "match": {
            "type": "BlueBabyDragon"
          }
        },
        "chance"
      ],
      "value": 250
    },
